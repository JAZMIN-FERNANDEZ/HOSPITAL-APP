<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtTituloWifi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalles de la red WiFi"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"/>

    <TextView
        android:id="@+id/txtSsid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SSID: "
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/txtTituloWifi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <TextView
        android:id="@+id/txtBssid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="BSSID: "
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/txtSsid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/txtVelocidad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Velocidad: "
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/txtBssid"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/txtRssi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Señal (RSSI): "
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/txtVelocidad"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/txtIp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Dirección IP: "
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/txtRssi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>