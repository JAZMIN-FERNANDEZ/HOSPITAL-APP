+import com.example.hospital.controlador.PacienteController;
+
+import java.util.List;
+
+public class VerTablasActivity extends AppCompatActivity {
+
+    // Arreglo fijo (no viene de input del usuario), por eso concatenar el
+    // nombre de tabla en la consulta del controller no es riesgo de SQL injection.
+    private static final String[] TABLAS = {
+            "pacientes", "doctor", "consultas", "egresos", "recetas", "detalle_receta", "usuarios"
+    };
+
+    private Spinner spinnerTablas;
+    private ListView listaContenidoTabla;
+    private PacienteController pacienteController;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setContentView(R.layout.activity_ver_tablas);
+
+        spinnerTablas = findViewById(R.id.spinnerTablas);
+        listaContenidoTabla = findViewById(R.id.listaContenidoTabla);
+        pacienteController = new PacienteController(this);
+
+        ArrayAdapter<String> adapterSpinner = new ArrayAdapter<>(this,
+                android.R.layout.simple_spinner_item, TABLAS);
+        adapterSpinner.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item);
+        spinnerTablas.setAdapter(adapterSpinner);
+
+        spinnerTablas.setOnItemSelectedListener(new AdapterView.OnItemSelectedListener() {
+            @Override
+            public void onItemSelected(AdapterView<?> parent, View view, int position, long id) {
+                mostrarContenidoTabla(TABLAS[position]);
+            }
+
+            @Override
+            public void onNothingSelected(AdapterView<?> parent) { }
+        });
+    }
+
+    private void mostrarContenidoTabla(String tabla) {
+        List<String> filas = pacienteController.obtenerContenidoTabla(tabla);
+        ArrayAdapter<String> adapterLista = new ArrayAdapter<>(this,
+                android.R.layout.simple_list_item_1, filas);
+        listaContenidoTabla.setAdapter(adapterLista);
+    }
+}
