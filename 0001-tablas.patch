+package com.example.hospital;
+
+import android.content.Intent;
+import android.os.Bundle;
+
+import androidx.appcompat.app.AppCompatActivity;
+
+import com.example.hospital.vista.LoginActivity;
+
+// Pantalla de arranque: solo redirige al Login.
+// No tiene layout propio porque no se alcanza a ver (transición inmediata).
+public class MainActivity extends AppCompatActivity {
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        startActivity(new Intent(MainActivity.this, LoginActivity.class));
+        finish();
+    }
+}
diff --git a/app/src/main/java/com/example/hospital/adaptador/ConsultaDetalleAdapter.java b/app/src/main/java/com/example/hospital/adaptador/ConsultaDetalleAdapter.java
new file mode 100644
index 0000000..fefa125
--- /dev/null
+++ b/app/src/main/java/com/example/hospital/adaptador/ConsultaDetalleAdapter.java
@@ -0,0 +1,55 @@
+package com.example.hospital.adaptador;
+
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.TextView;
+
+import androidx.annotation.NonNull;
+import androidx.recyclerview.widget.RecyclerView;
+
+import com.example.hospital.R;
+import com.example.hospital.model.ConsultaDetalle;
+
+import java.util.List;
+
+public class ConsultaDetalleAdapter extends RecyclerView.Adapter<ConsultaDetalleAdapter.ViewHolder> {
+
+    private final List<ConsultaDetalle> datos;
+
+    public ConsultaDetalleAdapter(List<ConsultaDetalle> datos) {
+        this.datos = datos;
+    }
+
+    @NonNull
+    @Override
+    public ViewHolder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
+        View vista = LayoutInflater.from(parent.getContext())
+                .inflate(R.layout.item_consulta_detalle, parent, false);
+        return new ViewHolder(vista);
+    }
+
+    @Override
+    public void onBindViewHolder(@NonNull ViewHolder holder, int position) {
+        ConsultaDetalle item = datos.get(position);
+        holder.txtPacienteDoctor.setText(item.getPaciente() + "  —  Dr(a). " + item.getDoctor());
+        holder.txtDiagnostico.setText("Diagnóstico: " + item.getDiagnostico());
+        holder.txtFecha.setText(item.getFechaRegistro());
+    }
+
+    @Override
+    public int getItemCount() {
+        return datos.size();
+    }
+
+    static class ViewHolder extends RecyclerView.ViewHolder {
