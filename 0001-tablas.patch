+package com.example.hospital.vista;
+
+import android.os.Bundle;
+import android.widget.Button;
+import android.widget.EditText;
+import android.widget.Toast;
+
+import androidx.appcompat.app.AppCompatActivity;
+
+import com.example.hospital.R;
+import com.example.hospital.controlador.PacienteController;
+
+public class PacienteActivity extends AppCompatActivity {
+
+    private EditText edtNombre, edtApellidoP, edtApellidoM, edtFechaNacimiento,
+            edtEdad, edtGenero, edtPeso;
+    private Button btnGuardarPaciente;
+    private PacienteController pacienteController;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setContentView(R.layout.activity_paciente);
+
+        edtNombre = findViewById(R.id.edtNombre);
+        edtApellidoP = findViewById(R.id.edtApellidoP);
+        edtApellidoM = findViewById(R.id.edtApellidoM);
+        edtFechaNacimiento = findViewById(R.id.edtFechaNacimiento);
+        edtEdad = findViewById(R.id.edtEdad);
+        edtGenero = findViewById(R.id.edtGenero);
+        edtPeso = findViewById(R.id.edtPeso);
+        btnGuardarPaciente = findViewById(R.id.btnGuardarPaciente);
+
+        pacienteController = new PacienteController(this);
+
+        btnGuardarPaciente.setOnClickListener(v -> guardarPaciente());
+    }
+
+    private void guardarPaciente() {
+        String nombre = edtNombre.getText().toString().trim();
+        String apellidoP = edtApellidoP.getText().toString().trim();
+        String apellidoM = edtApellidoM.getText().toString().trim();
+        String fechaNac = edtFechaNacimiento.getText().toString().trim();
+        String edadTexto = edtEdad.getText().toString().trim();
+        String genero = edtGenero.getText().toString().trim();
+        String pesoTexto = edtPeso.getText().toString().trim();
+
+        if (nombre.isEmpty() || apellidoP.isEmpty() || apellidoM.isEmpty()
+                || fechaNac.isEmpty() || edadTexto.isEmpty() || genero.isEmpty()
+                || pesoTexto.isEmpty()) {
+            Toast.makeText(this, "Completa todos los campos", Toast.LENGTH_SHORT).show();
+            return;
+        }
+
+        int edad;
+        double peso;
+        try {
+            edad = Integer.parseInt(edadTexto);
+            peso = Double.parseDouble(pesoTexto);
+        } catch (NumberFormatException e) {
+            Toast.makeText(this, "Edad y peso deben ser números", Toast.LENGTH_SHORT).show();
+            return;
+        }
+
+        long idPaciente = pacienteController.guardarPaciente(
+                nombre, apellidoP, apellidoM, fechaNac, edad, genero, peso);
+
+        if (idPaciente != -1) {
+            Toast.makeText(this, "Paciente guardado. Registra su consulta abajo.",
+                    Toast.LENGTH_SHORT).show();
+
+            // Deshabilita el formulario para no duplicar el registro por accidente
+            btnGuardarPaciente.setEnabled(false);
+
+            ConsultaFragment fragment = ConsultaFragment.newInstance((int) idPaciente);
+            getSupportFragmentManager().beginTransaction()
+                    .replace(R.id.fragment_container, fragment)
+                    .commit();
+        } else {
+            Toast.makeText(this, "No se pudo guardar el paciente", Toast.LENGTH_SHORT).show();
+        }
+    }
+}
