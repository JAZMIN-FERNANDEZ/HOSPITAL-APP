+        android:text="Detalles de la red WiFi"
+        android:textSize="22sp"
+        android:textStyle="bold"
+        app:layout_constraintTop_toTopOf="parent"
+        app:layout_constraintStart_toStartOf="parent"
+        app:layout_constraintEnd_toEndOf="parent"
+        android:layout_marginTop="40dp"/>
+
+    <TextView
+        android:id="@+id/txtSsid"
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:text="SSID: "
+        android:textSize="16sp"
+        app:layout_constraintTop_toBottomOf="@id/txtTituloWifi"
+        app:layout_constraintStart_toStartOf="parent"
+        app:layout_constraintEnd_toEndOf="parent"
+        android:layout_marginTop="32dp"/>
+
+    <TextView
+        android:id="@+id/txtBssid"
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:text="BSSID: "
+        android:textSize="16sp"
+        app:layout_constraintTop_toBottomOf="@id/txtSsid"
+        app:layout_constraintStart_toStartOf="parent"
+        app:layout_constraintEnd_toEndOf="parent"
+        android:layout_marginTop="16dp"/>
+
+    <TextView
+        android:id="@+id/txtVelocidad"
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:text="Velocidad: "
+        android:textSize="16sp"
+        app:layout_constraintTop_toBottomOf="@id/txtBssid"
+        app:layout_constraintStart_toStartOf="parent"
+        app:layout_constraintEnd_toEndOf="parent"
+        android:layout_marginTop="16dp"/>
+
+    <TextView
+        android:id="@+id/txtRssi"
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:text="Señal (RSSI): "
+        android:textSize="16sp"
+        app:layout_constraintTop_toBottomOf="@id/txtVelocidad"
+        app:layout_constraintStart_toStartOf="parent"
+        app:layout_constraintEnd_toEndOf="parent"
+        android:layout_marginTop="16dp"/>
+
+    <TextView
+        android:id="@+id/txtIp"
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:text="Dirección IP: "
+        android:textSize="16sp"
+        app:layout_constraintTop_toBottomOf="@id/txtRssi"
+        app:layout_constraintStart_toStartOf="parent"
