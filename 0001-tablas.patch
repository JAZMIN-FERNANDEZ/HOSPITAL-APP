+package com.example.hospital.vista;
+
+import android.os.Bundle;
+import android.text.format.DateFormat;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ArrayAdapter;
+import android.widget.Button;
+import android.widget.EditText;
+import android.widget.Spinner;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.fragment.app.Fragment;
+
+import com.example.hospital.R;
+import com.example.hospital.controlador.PacienteController;
+import com.example.hospital.model.Doctor;
+
+import java.util.Date;
+import java.util.List;
+
+// El fragment contiene la información de la consulta y su hora de salida:
+// al "Finalizar consulta" se registra en `consultas` Y en `egresos` a la vez.
+public class ConsultaFragment extends Fragment {
+
+    private static final String ARG_ID_PACIENTE = "id_paciente";
+
+    private int idPaciente;
+    private PacienteController pacienteController;
+    private List<Doctor> doctores;
+
+    private Spinner spinnerDoctores;
+    private EditText edtAlergias, edtSintomas, edtDiagnostico, edtObservacionesEgreso;
+    private Button btnFinalizarConsulta;
+
+    public static ConsultaFragment newInstance(int idPaciente) {
+        ConsultaFragment fragment = new ConsultaFragment();
+        Bundle args = new Bundle();
+        args.putInt(ARG_ID_PACIENTE, idPaciente);
+        fragment.setArguments(args);
+        return fragment;
+    }
+
+    @Override
+    public void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        if (getArguments() != null) {
+            idPaciente = getArguments().getInt(ARG_ID_PACIENTE);
+        }
+    }
+
+    @Nullable
+    @Override
+    public View onCreateView(@NonNull LayoutInflater inflater, @Nullable ViewGroup container,
+                              @Nullable Bundle savedInstanceState) {
+        return inflater.inflate(R.layout.fragment_consulta, container, false);
+    }
+
+    @Override
+    public void onViewCreated(@NonNull View view, @Nullable Bundle savedInstanceState) {
+        super.onViewCreated(view, savedInstanceState);
+
+        spinnerDoctores = view.findViewById(R.id.spinnerDoctores);
+        edtAlergias = view.findViewById(R.id.edtAlergias);
+        edtSintomas = view.findViewById(R.id.edtSintomas);
+        edtDiagnostico = view.findViewById(R.id.edtDiagnostico);
+        edtObservacionesEgreso = view.findViewById(R.id.edtObservacionesEgreso);
+        btnFinalizarConsulta = view.findViewById(R.id.btnFinalizarConsulta);
+
+        pacienteController = new PacienteController(requireContext());
+
+        cargarDoctores();
+
+        btnFinalizarConsulta.setOnClickListener(v -> finalizarConsulta());
+    }
+
+    private void cargarDoctores() {
+        doctores = pacienteController.obtenerDoctores();
+        ArrayAdapter<Doctor> adapter = new ArrayAdapter<>(requireContext(),
+                android.R.layout.simple_spinner_item, doctores);
+        adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item);
+        spinnerDoctores.setAdapter(adapter);
+    }
+
+    private void finalizarConsulta() {
+        if (doctores == null || doctores.isEmpty()) {
+            Toast.makeText(requireContext(), "No hay doctores registrados", Toast.LENGTH_SHORT).show();
+            return;
+        }
+
+        String alergias = edtAlergias.getText().toString().trim();
+        String sintomas = edtSintomas.getText().toString().trim();
+        String diagnostico = edtDiagnostico.getText().toString().trim();
+        String observacionesEgreso = edtObservacionesEgreso.getText().toString().trim();
+
+        if (alergias.isEmpty() || sintomas.isEmpty() || diagnostico.isEmpty()
+                || observacionesEgreso.isEmpty()) {
+            Toast.makeText(requireContext(), "Completa todos los campos", Toast.LENGTH_SHORT).show();
+            return;
+        }
+
+        Doctor doctorSeleccionado = (Doctor) spinnerDoctores.getSelectedItem();
+        String horaSalida = DateFormat.format("HH:mm:ss", new Date()).toString();
+
+        boolean exito = pacienteController.registrarConsultaYEgreso(
+                idPaciente, doctorSeleccionado.getIdDoctor(),
+                alergias, sintomas, diagnostico, observacionesEgreso, horaSalida);
+
+        if (exito) {
+            Toast.makeText(requireContext(), "Consulta y egreso registrados correctamente",
+                    Toast.LENGTH_LONG).show();
+            requireActivity().finish();
+        } else {
+            Toast.makeText(requireContext(), "No se pudo registrar la consulta", Toast.LENGTH_SHORT).show();
+        }
+    }
+}
