diff --git a/app/src/main/res/layout/fragment_consulta.xml b/app/src/main/res/layout/fragment_consulta.xml
new file mode 100644
index 0000000..b95b109
--- /dev/null
+++ b/app/src/main/res/layout/fragment_consulta.xml
@@ -0,0 +1,68 @@
+<?xml version="1.0" encoding="utf-8"?>
+<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="#F5F5F5">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:orientation="vertical"
+        android:padding="24dp">
+
+        <TextView
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:text="Datos de la consulta"
+            android:textSize="20sp"
+            android:textStyle="bold"
+            android:layout_marginBottom="16dp"/>
+
+        <TextView
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:text="Doctor que atiende"
+            android:textSize="14sp"/>
+
+        <Spinner
+            android:id="@+id/spinnerDoctores"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginBottom="12dp"/>
+
+        <EditText
+            android:id="@+id/edtAlergias"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:hint="Alergias (ej. Ninguna)"/>
+
+        <EditText
+            android:id="@+id/edtSintomas"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:hint="Observaciones / síntomas"
+            android:layout_marginTop="12dp"/>
+
+        <EditText
+            android:id="@+id/edtDiagnostico"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:hint="Diagnóstico"
+            android:layout_marginTop="12dp"/>
+
+        <EditText
+            android:id="@+id/edtObservacionesEgreso"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:hint="Observaciones de egreso"
+            android:layout_marginTop="12dp"/>
+
+        <Button
+            android:id="@+id/btnFinalizarConsulta"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:text="Finalizar consulta"
+            android:layout_marginTop="20dp"/>
+
+    </LinearLayout>
+</ScrollView>
